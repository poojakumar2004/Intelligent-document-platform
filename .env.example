# ==============================================================================
# Intelligent Document Extraction, Validation & API Platform
# Environment Configuration Template
# ==============================================================================

# Server Environment
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production

# Database & Storage
DATABASE_PATH=documents.db
UPLOAD_DIR=uploads

# Document & Processing Constraints
MAX_PAGES=3
MAX_FILE_SIZE_BYTES=10485760
FINANCIAL_TOLERANCE=0.05

# OCR & AI Services (Optional - Built-in fallback available if not provided)
# OCR.Space API Key (free registration at https://ocr.space/ocrapi)
OCR_SPACE_API_KEY=helloworld

# Google Gemini API Key (for multimodal vision extraction)
GEMINI_API_KEY=
